{
  "name": "@hackersandwizards/testimonials",
  "version": "3.0.0",
  "description": "Client quotes, portraits and company marks of hackers&wizards: the one source every surface takes them from.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackersandwizards/testimonials.git"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./testimonials.json": "./data/testimonials.json",
    "./marks.json": "./data/marks.json",
    "./marks/*": "./marks/*",
    "./portraits/*": "./portraits/*"
  },
  "files": [
    "src/index.js",
    "src/index.d.ts",
    "data",
    "marks",
    "portraits"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "check": "scaffolding check",
    "check:staged": "check-staged",
    "test": "bun test --timeout ${SCAFFOLDING_TEST_TIMEOUT_MS:-5000}",
    "marks:measure": "bun scripts/marks.ts",
    "retouch:portrait": "bun scripts/retouch-portrait.ts"
  },
  "scaffolding": {
    "allow": [
      {
        "check": "confidential",
        "path": [
          "marks/adference.svg",
          "marks/aktion-mensch.png",
          "marks/atmina-solutions.svg",
          "marks/b-braun.svg",
          "marks/bauhaus.svg",
          "marks/betterhomes.svg",
          "marks/beurer.svg",
          "marks/candylabs.svg",
          "marks/certificates-dev.svg",
          "marks/conceptboard.svg",
          "marks/continentale.svg",
          "marks/destination-solutions.svg",
          "marks/e-motion-experts.svg",
          "marks/edataconsulting.png",
          "marks/finnofleet.svg",
          "marks/fiskaly.svg",
          "marks/giga-green.svg",
          "marks/heise-conferences.svg",
          "marks/hsh.png",
          "marks/hws.svg",
          "marks/impower.svg",
          "marks/kleinanzeigen.svg",
          "marks/launch-lab.png",
          "marks/lotto24.svg",
          "marks/mobil-isc.png",
          "marks/obi.svg",
          "marks/phantomrausch.svg",
          "marks/rheinwerk-verlag.svg",
          "marks/silverspin.png",
          "marks/sopra-steria.svg",
          "marks/startplatz.png",
          "marks/techniker-krankenkasse.svg",
          "marks/tk-elevator.svg",
          "marks/vodafone.svg",
          "marks/vorwerk-patron.png",
          "marks/westwerk-events.svg",
          "portraits/belma-ibrahimovic.webp"
        ],
        "text": [
          "adference",
          "aktion mensch",
          "atmina solutions",
          "b braun",
          "bauhaus",
          "belma ibrahimovic",
          "betterhomes",
          "beurer",
          "candylabs",
          "certificates dev",
          "conceptboard",
          "continentale",
          "destination solutions",
          "e motion experts",
          "edataconsulting",
          "finnofleet",
          "fiskaly",
          "giga green",
          "heise conferences",
          "hsh",
          "hws",
          "impower",
          "kleinanzeigen",
          "launch lab",
          "lotto24",
          "mobil isc",
          "obi",
          "phantomrausch",
          "rheinwerk verlag",
          "silverspin",
          "sopra steria",
          "startplatz",
          "techniker krankenkasse",
          "tk elevator",
          "vodafone",
          "vorwerk patron",
          "westwerk events"
        ],
        "reason": "a mark file or portrait named for its company or person, and the wordmark OCR reads in a mark, per the founders' decision that this public repository holds them all"
      },
      {
        "check": "confidential",
        "path": "CLAUDE.md",
        "text": "OBI",
        "reason": "names the one company whose mark is never shown, so the rule can say so"
      },
      {
        "check": "confidential",
        "path": "data/marks.json",
        "text": [
          "ADFERENCE",
          "aktion mensch",
          "atmina solutions",
          "b braun",
          "bauhaus",
          "BETTERHOMES",
          "beurer",
          "candylabs",
          "certificates dev",
          "conceptboard",
          "continentale",
          "destination solutions",
          "dmtech",
          "e motion experts",
          "edataconsulting",
          "FINNOFLEET",
          "fiskaly",
          "giga green",
          "haufe lexware",
          "heise conferences",
          "HSH",
          "HWS",
          "impower",
          "kleinanzeigen",
          "launch lab",
          "LOTTO24",
          "MediaMarktSaturn",
          "mobil isc",
          "OBI",
          "phantomrausch",
          "rheinwerk verlag",
          "silverspin",
          "sopra steria",
          "STARTPLATZ",
          "techniker krankenkasse",
          "Thüga SmartService",
          "tk elevator",
          "vodafone",
          "vorwerk elektrowerke",
          "vorwerk patron",
          "vorwerk services",
          "westwerk events"
        ],
        "reason": "a company's name and slug in its mark entry: the founders decided that this public repository holds every company mark h&w keeps, unreleased and `never` ones included; `surface` keeps such a mark off every rendered surface"
      },
      {
        "check": "confidential",
        "path": "data/testimonials.json",
        "text": [
          "belma ibrahimovic",
          "vorwerk elektrowerke"
        ],
        "reason": "a quoted person's name and their company's slug, as published with the quote on hackersandwizards.dev"
      },
      {
        "check": "confidential",
        "path": "src/index.test.ts",
        "text": "OBI",
        "reason": "the test that holds this company's mark at `never`"
      }
    ],
    "check": [],
    "skip": {
      "catalog": "a data package: its consumers render the entries, it has no surface of its own",
      "styles": "no stylesheet",
      "admin": "the admin package pulls brand in as a peer, and brand takes its marks from this package"
    },
    "test": "test"
  },
  "prettier": "@hackersandwizards/scaffolding/prettier",
  "overrides": {
    "minimatch": "11.0.5"
  },
  "devDependencies": {
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v5.15.0",
    "@types/bun": "1.4.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
