---
import type { FilterItem } from "@hackersandwizards/brand/elements/list-filter.ts";
import ListFilter from "@hackersandwizards/brand/expert/components/ListFilter.astro";
import Layout from "../layouts/Layout.astro";
import MarkCard from "../components/MarkCard.astro";
import { filterCopy, marks, options, quotesOf, splitting, surfaceLabel } from "../lib/data";

const rows = marks.map((mark) => {
  const filter: FilterItem = {
    text: [mark.name, mark.slug, mark.file].join(" "),
    facets: {
      surface: [mark.surface],
      tile: [mark.ownTile ? "own" : "transparent"],
      onepager: [mark.onepager === false ? "off" : "on"],
      strip: [mark.strip === false ? "off" : "on"],
      quoted: [quotesOf(mark).length ? "yes" : "no"],
    },
  };
  return { mark, filter };
});
const items = rows.map((r) => r.filter);
const facets = splitting(
  [
    {
      param: "surface",
      legend: "Surface",
      options: options(surfaceLabel),
    },
    {
      param: "quoted",
      legend: "Quote",
      options: [
        { value: "yes", label: "Quoted" },
        { value: "no", label: "No quote" },
      ],
    },
    {
      param: "tile",
      legend: "Ground",
      options: [
        { value: "transparent", label: "Transparent" },
        { value: "own", label: "Own tile" },
      ],
    },
    {
      param: "onepager",
      legend: "Onepagers",
      options: [
        { value: "on", label: "On onepagers" },
        { value: "off", label: "Off onepagers" },
      ],
    },
    {
      param: "strip",
      legend: "Logo strip",
      options: [
        { value: "on", label: "On strip" },
        { value: "off", label: "Off strip" },
      ],
    },
  ],
  items,
);
---

<Layout
  title="Marks"
  description="Every company mark in this package on a light and a night ground, with its surface, flags, file and source."
  current="/marks/"
>
  <div class="mx-auto w-full max-w-content px-gutter pb-section">
    <h1 class="mt-8 font-mono text-h2 font-bold">Marks</h1>
    <p class="mt-2 max-w-measure text-muted">
      Every mark in <code>data/marks.json</code>, in display order, on a light and a night ground,
      each at its scale of a 48 px logo row. Allowed marks may show on a surface; unreleased ones
      show only here, and a mark that is never shown is listed without its drawing.
    </p>

    <div class="mt-8">
      <ListFilter
        id="find"
        action="/marks/"
        label="Find a company, slug or file"
        items={items}
        state={{ q: "", facets: {} }}
        facets={facets}
        count="{shown} of {total} marks"
        copy={{ ...filterCopy, empty: "No mark matches." }}
      >
        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {rows.map((r) => (
            <MarkCard mark={r.mark} filter={r.filter} />
          ))}
        </ul>
      </ListFilter>
    </div>
  </div>
</Layout>
