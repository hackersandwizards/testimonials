---
import { inlined, markSvg, markUrl, type Mark } from "../lib/data";

interface Props {
  mark: Mark;
  /** The logo row's height in px. */
  row: number;
}
const { mark, row } = Astro.props;
const height = Math.round(mark.scale * row * 10) / 10;
const svg = inlined(mark) && markSvg(mark);
const width = Math.round((height * mark.size.width) / mark.size.height);
---

{svg ? (
  <span
    class="mark-inline block max-w-full"
    role="img"
    aria-label={mark.name}
    style={`height: ${height}px`}
    set:html={svg}
  />
) : (
  <img
    class="block max-w-full object-contain"
    src={markUrl(mark)}
    alt={mark.name}
    width={width}
    height={height}
    style={`height: ${height}px; width: auto`}
    loading="lazy"
    decoding="async"
  />
)}

<style>
  .mark-inline :global(svg) {
    display: block;
    width: auto;
    max-width: 100%;
    height: 100%;
  }
</style>
