---
import AppHeader from "@hackersandwizards/brand/expert/components/AppHeader.astro";
import ThemeToggle from "@hackersandwizards/brand/expert/components/ThemeToggle.astro";
import faviconIco from "@hackersandwizards/brand/logos/favicon.ico?url";
import faviconSvg from "@hackersandwizards/brand/logos/favicon.svg?url";
import { links } from "../lib/links";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  current: "/" | "/marks/";
}
const { title, description, current } = Astro.props;
---

<!doctype html>
<html lang="en" class="hw-focus-ring" data-hw-night>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <title>{title} | hackers&wizards</title>
    <link rel="icon" href={faviconIco} sizes="32x32" />
    <link rel="icon" href={faviconSvg} type="image/svg+xml" />
    {/* Applied before first paint, or the wrong theme flashes. */}
    <script is:inline>
      let theme;
      // Storage can be blocked (site data off); the system preference still holds.
      try {
        theme = localStorage.getItem("theme");
      } catch {}
      theme ||= window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>
  <body>
    <AppHeader product="Testimonials">
      <nav class="hw-header-nav" aria-label="Main">
        {links.map((l) => (
          <a
            class:list={["hw-header-link", l.href === "/catalog/" && "wide"]}
            href={l.href}
            aria-current={l.href === current ? "page" : undefined}
          >
            {l.name}
          </a>
        ))}
        <ThemeToggle />
      </nav>
    </AppHeader>
    <main class="w-full flex-1">
      <slot />
    </main>
  </body>
</html>

<style>
  /* On a phone the bar drops the catalog, which is for whoever builds the site, here because
     header.css draws its links outside a cascade layer, where a utility cannot hide one. */
  @media (width < 40rem) {
    .hw-header-link.wide {
      display: none;
    }
  }
</style>
